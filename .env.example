# Copy to .env.local and fill in. Restart `npm run dev` after changes.

# Razorpay online payments (Dashboard → Account & Settings → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Confirmed orders (paid online and cash-on-delivery) are POSTed here as JSON.
# Point it at your order backend, a Google Apps Script, Zapier, Make, etc.
# Cash on delivery stays disabled until this is set.
ORDER_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>"
ORDER_WEBHOOK_SECRET=

# Newsletter sign-ups ({ email, source }) are POSTed here.
NEWSLETTER_WEBHOOK_URL=

# Optional: serve brand images from a CDN instead of /public (e.g. https://www.thecaffix.in)
NEXT_PUBLIC_ASSET_ORIGIN=
